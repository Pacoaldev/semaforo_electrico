# =========================================================
#  Semaforo Electrico - Plantilla de variables de entorno
#  Copia este archivo a ".env" y rellena los valores.
# =========================================================

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-unica
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos ---
USE_SQLITE=False
DATABASE_URL=postgres://usuario:password@localhost:5432/nombre_db
POSTGRES_DB=semaforo_db
POSTGRES_USER=semaforo_user
POSTGRES_PASSWORD=semaforo_pass

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Refresco diario protegido por token (cron externo gratuito) ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET_TOKEN=
